# Example environment for a hosted IBVAP container.
# Copy values into your host's secret manager (HF Space "Variables & secrets").
# NEVER commit real secrets.

# Postgres connection string. For Neon use the *pooled* endpoint and keep
# sslmode=require:
DATABASE_URL=postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Required whenever the deployment is reachable by anyone but you:
JWT_SECRET=generate-a-long-random-string-here

# Auto-start the seeded demo cameras on boot (simulated feeds, labelled in UI):
IBVAP_DEMO=1

# Force the CPU path in GPU-less containers so the System page reports honestly:
IBVAP_CPU_ONLY=1

# OCR device: cpu (default, leaves VRAM free) or gpu (local boxes only):
IBVAP_OCR_DEVICE=cpu
